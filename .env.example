# 복사해서 .env.local 로 사용하세요. 실제 키는 절대 저장소에 올리지 않습니다 (.env.local 은 git에서 제외됨).

# AI 상담 (Claude). https://console.anthropic.com
ANTHROPIC_API_KEY=

# 공공데이터포털(data.go.kr) 일반 인증키. 아래 API를 각각 '활용신청'해야 같은 키로 호출됩니다.
#  - 중앙부처복지서비스, 지자체복지서비스 (한국사회보장정보원)
#  - 아파트·연립다세대·오피스텔 전월세 실거래가 (국토교통부)
#  - 분양임대공고문 조회 (한국토지주택공사)
#  - 한눈에보는문화정보조회서비스 (한국문화정보원)
DATA_GO_KR_KEY=

# 온통청년 청년정책 API 인증키. data.go.kr 이 아니라 youthcenter.go.kr 마이페이지 > OPEN API 에서 발급
YOUTH_API_KEY=

# 식품안전나라 레시피 API 인증키 (https://www.foodsafetykorea.go.kr 에서 무료 발급).
# 비워 두면 공개 샘플 키로 동작하며 질의당 5건만 돌려줍니다.
FOODSAFETY_KEY=

# (선택) 채팅 요청 제한. 기본값: IP당 시간당 20회, 서버 인스턴스당 하루 400회
# CHAT_PER_IP_PER_HOUR=20
# CHAT_GLOBAL_PER_DAY=400
